---
// One face of a landing tile. kind: name | key | link | lang | photo | tagline
const { f, mode, style } = Astro.props;
const icons = {
  mask: '<path d="M14 18h72v30c0 22-14 36-36 36S14 70 14 48z"/><path d="M30 42q8-8 16 0M54 42q8-8 16 0"/><path d="M32 62q18 16 36 0"/>',
  star: '<path d="M50 6l13 28 30 4-22 21 6 30-27-15-27 15 6-30L7 38l30-4z"/>',
  clap: '<path d="M10 40h80v48H10z"/><path d="M10 40l8-22 72 8-4 14z"/><path d="M28 22l-4 14M48 24l-4 14M68 26l-4 14"/>',
  flow: '<rect x="8" y="10" width="30" height="20"/><rect x="62" y="40" width="30" height="20"/><rect x="8" y="70" width="30" height="20"/><path d="M38 20h24v20M62 50H50V80H38"/>',
  ticket: '<path d="M8 28h84v14a8 8 0 000 16v14H8V58a8 8 0 000-16z"/><path d="M64 28v44" stroke-dasharray="4 6"/>',
  bubble: '<path d="M10 14h80v52H46L24 88V66H10z"/><path d="M26 34h48M26 48h30"/>',
};
const arrow = '<path d="M8 50h76M54 20l30 30-30 30"/>';
---
{f.kind === 'name' && <div class="face name" data-m={mode} style={style}><span class="big">Berkay<br />Yazar</span></div>}
{f.kind === 'tagline' && <div class="face tagline" data-m={mode} style={style}><span class="big">{f.label}</span></div>}
{f.kind === 'key' && (
  <a class:list={['face key', { active: f.active, quiet: f.quiet }]} href={f.href} data-m={mode} aria-current={f.active ? 'page' : undefined} style={style}>
    <span><span class="big">{f.label}</span><span class="sub">{f.sub}</span></span>
    {!f.active && <svg viewBox="0 0 100 100" class="arrow" aria-hidden="true" set:html={arrow} />}
  </a>
)}
{f.kind === 'link' && (
  <a class:list={['face link', { down: f.down }]} href={f.href} data-m={mode} style={style}>
    <span class="big">{f.label}</span>
    <svg viewBox="0 0 100 100" class="arrow" aria-hidden="true" set:html={arrow} />
  </a>
)}
{f.kind === 'lang' && <a class="face lang" href={f.href} data-m={mode} hreflang={f.label.toLowerCase()} style={style}><span class="big">{f.label}</span></a>}
{f.kind === 'photo' && (
  <div class="face photo" data-m={mode} aria-hidden="true" style={style}>
    {f.src ? <img src={f.src} alt="" loading="lazy" /> : <svg viewBox="0 0 100 100" class="ico" set:html={icons[f.icon]} />}
  </div>
)}
