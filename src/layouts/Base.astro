---
const { lang, title, path = '' } = Astro.props;
const other = lang === 'tr' ? 'en' : 'tr';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 0 auto; padding: 1.5rem 1rem; line-height: 1.6; }
      nav { display: flex; justify-content: space-between; margin-bottom: 2rem; }
      .item { margin-bottom: 1rem; }
      .meta { color: #666; }
    </style>
  </head>
  <body>
    <nav>
      <a href={`/${lang}/`}>←</a>
      <a href={`/${other}/${path}`}>{other.toUpperCase()}</a>
    </nav>
    <slot />
  </body>
</html>
